# Copy this to .env and fill in for real deploys to Sepolia.
# NEVER commit .env to git.

# Sepolia RPC endpoint. Get a free one from Alchemy/Infura, or use a public one.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer private key (with 0x prefix). Use a throwaway wallet with test ETH only.
PRIVATE_KEY=

# Etherscan API key for contract verification. Get free from etherscan.io.
ETHERSCAN_API_KEY=